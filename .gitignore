# AfricAIsoft Portable Studio - fichiers non versionnés

# Modèles GGUF utilisateur (peuvent peser plusieurs Go)
models/*.gguf
models/*.bin

# Binaires téléchargés/compilés (récupérés par scripts/fetch-binaries.*)
bin/**/llama-server
bin/**/llama-server.exe
bin/**/*.so
bin/**/*.so.*
bin/**/*.dylib
bin/**/*.dll
bin/**/LICENSE
bin/**/ggml-*

# Runtime Python portable (récupéré par scripts/setup-python.*)
runtime/**/python/

# Logs et données runtime
logs/*.log
logs/*.log.*
data/pids/*.pid
data/pids/*.json
# Conversations utilisateur (créées au runtime) — jamais commiter (peut
# contenir des données sensibles saisies par l'opérateur/utilisateur final).
data/conversations.json

# Cache de téléchargement local
.cache/

# Configuration utilisateur (créée au 1er lancement depuis settings.example.json).
# NE JAMAIS COMMITER settings.json : peut contenir des origines CORS internes,
# des chemins de modèles privés, ou des overrides d'auth.
config/settings.json
config/api_key.txt
config/system_prompt.txt

# Index RAG (généré au premier scan)
skills/*/.index/

# Standards Python / OS
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.DS_Store
Thumbs.db

# Artefacts .NET (Key Builder) - JAMAIS commiter les binaires compilés.
# Ciblage précis pour ne PAS toucher au bin/ racine qui héberge llama-server.
keybuilder/**/bin/
keybuilder/**/obj/
keybuilder/artifacts/

# Clés privées Ed25519 (fabricant) — ne jamais commiter.
# La clé PUBLIQUE (keys/public.pem) peut être publiée : elle est
# embarquée dans config/public.pem à chaque release signée.
keys/private.pem

# Artefacts de l'environnement de développement (hors périmètre produit).
memory/

# Distribution portable générée par scripts/build-portable.sh
dist/

# Emergent / IDE
.emergent/
.vscode/
.idea/

# Fichiers temporaires
*.tmp
*.swp
*~
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
# Fichier de règles filter-repo pour purge historique de secrets — ne
# jamais commiter (contient la valeur en clair du token à redacter).
.token-redact.txt

# Logs de build llama.cpp local (script scripts/build-llama-server.sh).
.build-*.log
.cache/llama.cpp/

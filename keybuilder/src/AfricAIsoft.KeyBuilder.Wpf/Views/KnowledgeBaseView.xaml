<!-- ═════════════════════════════════════════════════════════════════════════
     Rôle    : vue de sélection de la base de connaissances (RAG). S'appuie
               sur MainViewModel via l'héritage du DataContext parent.
               Contient : boutons d'ajout (fichiers/dossier/tout retirer),
               liste des documents planifiés, résumé taille+warnings, et
               case à cocher « Réindexer au premier démarrage ».
     Note    : AUCUNE chaîne visible en dur — tout le texte passe par
               {x:Static props:Resources.*} → Properties/Resources.resx (FR)
               ou Resources.en-US.resx (EN).
     Auteur  : AfricAIsoft — Licence : MIT
     ═════════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="AfricAIsoft.KeyBuilder.Wpf.Views.KnowledgeBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AfricAIsoft.KeyBuilder.Wpf.ViewModels"
             xmlns:props="clr-namespace:AfricAIsoft.KeyBuilder.Wpf.Properties"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock FontWeight="Bold"
                   Text="{x:Static props:Resources.KnowledgeBaseTitle}"/>
        <TextBlock Foreground="Gray" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6"
                   Text="{x:Static props:Resources.KnowledgeBaseHint}"/>

        <!-- ═════════ Boutons d'action ═════════ -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
            <Button Content="{x:Static props:Resources.AddKnowledgeFilesBtn}"
                    Command="{Binding AddKnowledgeFilesCommand}"
                    Padding="10,4" Margin="0,0,6,0"
                    ToolTip="{x:Static props:Resources.KnowledgeAddFilesTooltip}"/>
            <Button Content="{x:Static props:Resources.AddKnowledgeFolderBtn}"
                    Command="{Binding AddKnowledgeFolderCommand}"
                    Padding="10,4" Margin="0,0,6,0"
                    ToolTip="{x:Static props:Resources.KnowledgeAddFolderTooltip}"/>
            <Button Content="{x:Static props:Resources.ClearKnowledgeBtn}"
                    Command="{Binding ClearKnowledgeCommand}"
                    Padding="10,4"/>
        </StackPanel>

        <!-- ═════════ Liste des documents planifiés ═════════ -->
        <ListView ItemsSource="{Binding KnowledgeItems}"
                  MaxHeight="220" MinHeight="80"
                  BorderBrush="{StaticResource Border}" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static props:Resources.KnowledgeColumnDocument}"
                                    Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}"
                                           ToolTip="{Binding SourcePath}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{x:Static props:Resources.KnowledgeColumnRelative}"
                                    Width="220"
                                    DisplayMemberBinding="{Binding RelativePath}"/>
                    <GridViewColumn Header="{x:Static props:Resources.KnowledgeColumnSize}"
                                    Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource Mono}" FontSize="12"
                                           HorizontalAlignment="Right"
                                           Text="{Binding SizeBytes, StringFormat={}{0:N0}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{x:Static props:Resources.RemoveKnowledgeItemBtn}"
                                        Padding="6,2" FontSize="11"
                                        Command="{Binding DataContext.RemoveKnowledgeItemCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ═════════ Résumé taille + warning >50 Mo (généré par le VM) ═════════ -->
        <TextBlock Text="{Binding KnowledgeSummary}" Foreground="Gray"
                   FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,6,0,0"/>

        <!-- ═════════ Case à cocher réindexation ═════════ -->
        <CheckBox Content="{x:Static props:Resources.KnowledgeReindexOnFirstLaunch}"
                  IsChecked="{Binding KnowledgeReindexOnFirstLaunch}"
                  ToolTip="{x:Static props:Resources.KnowledgeReindexTooltip}"
                  Margin="0,10,0,4"/>

        <Separator Margin="0,10,0,4"/>
    </StackPanel>
</UserControl>

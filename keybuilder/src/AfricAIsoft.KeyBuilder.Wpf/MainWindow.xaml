<Window x:Class="AfricAIsoft.KeyBuilder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AfricAIsoft.KeyBuilder.Wpf.ViewModels"
        Title="AfricAIsoft Key Builder"
        Width="1180" Height="780" MinWidth="960" MinHeight="640"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource Serif}" FontSize="14">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ═════════ Bandeau ═════════ -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Accent}">AfricAIsoft Key Builder</TextBlock>
            <TextBlock DockPanel.Dock="Right" Foreground="Gray"
                       Text="{Binding StatusText}"/>
        </DockPanel>

        <!-- ═════════ 3 colonnes : USB / Contenu / Options ═════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- USB detection -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold"
                               Text="Clés USB détectées"/>
                    <Button DockPanel.Dock="Top" Content="Rafraîchir"
                            Command="{Binding RefreshDrivesCommand}" Margin="0,6"/>
                    <ListBox ItemsSource="{Binding Drives}"
                             SelectedItem="{Binding SelectedDrive}"
                             DisplayMemberPath="DisplayText"/>
                </DockPanel>
            </Border>

            <!-- Content builder -->
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="Modèle GGUF"/>
                        <ComboBox ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel}"
                                  DisplayMemberPath="Description" Margin="0,4,0,12"/>
                        <TextBlock FontWeight="Bold" Text="Skills MCP à inclure"/>
                        <ItemsControl ItemsSource="{Binding Skills}" Margin="0,4,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontWeight="Bold" Text="Plateformes cibles"/>
                        <ItemsControl ItemsSource="{Binding Platforms}" Margin="0,4,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontWeight="Bold" Text="System Prompt personnalisé"/>
                        <TextBox Text="{Binding CustomSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="120" FontFamily="{StaticResource Mono}"
                                 Margin="0,4,0,12" VerticalScrollBarVisibility="Auto"/>
                        <Button Content="Importer un fichier..." HorizontalAlignment="Left"
                                Command="{Binding ImportPromptCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Options -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Personnalisation"/>
                    <TextBlock Text="Nom volume :" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding VolumeLabel}"/>
                    <TextBlock Text="Version :" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Version}"/>
                    <TextBlock Text="Identifiant client :" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding ClientId}"/>
                    <TextBlock Text="Système de fichiers :" Margin="0,8,0,0"/>
                    <ComboBox ItemsSource="{Binding AvailableFileSystems}"
                              SelectedItem="{Binding SelectedFileSystem}"/>
                    <CheckBox Content="Formater avant copie"
                              IsChecked="{Binding FormatBeforeCopy}" Margin="0,8,0,0"/>
                    <CheckBox Content="Vérification SHA-256 post-copie"
                              IsChecked="{Binding VerifyChecksums}"/>
                    <CheckBox Content="Test de démarrage rapide"
                              IsChecked="{Binding RunSmokeTest}"/>
                    <Separator Margin="0,12"/>
                    <TextBlock FontWeight="Bold" Text="Estimation"/>
                    <TextBlock Text="{Binding SizeEstimationText}" Margin="0,4,0,0"
                               FontFamily="{StaticResource Mono}"/>
                    <ProgressBar Height="10" Margin="0,4"
                                 Minimum="0" Maximum="100" Value="{Binding SizeFillPercent}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════ Barre du bas ═════════ -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <ProgressBar DockPanel.Dock="Left" Width="380" Height="18"
                         Minimum="0" Maximum="100" Value="{Binding OverallProgress}"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentStepText}"
                       VerticalAlignment="Center" Margin="12,0"/>
            <Button DockPanel.Dock="Right" Padding="16,6" Content="Fabriquer la clé"
                    Background="{StaticResource Accent}" Foreground="White"
                    Command="{Binding BuildCommand}"/>
            <Button DockPanel.Dock="Right" Content="Ajouter au batch"
                    Command="{Binding AddToBatchCommand}" Margin="0,0,8,0" Padding="12,6"/>
            <Button DockPanel.Dock="Right" Content="Exécuter batch"
                    Command="{Binding RunBatchCommand}" Margin="0,0,8,0" Padding="12,6"/>
        </DockPanel>
    </Grid>
</Window>
